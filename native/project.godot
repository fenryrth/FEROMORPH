; FEROMORPH Native — Godot 4.7.1
; This project intentionally uses the Compatibility renderer for broad Linux support.

config_version=5

[application]

config/name="FEROMORPH Native"
config/description="An autonomous generative digital sculpture by Michael Gram."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.004, 0.004, 0.005, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.004, 0.004, 0.005, 1)

[physics]

common/enable_pause_aware_picking=true

[audio]

driver/enable_input=false
